<file path=".github/workflows/03-invoke-jules.yml">
name: Invoke Jules for Article
on:
  workflow_run:
    workflows: ["Jules Publish Pipeline"]
    types: [completed]
  workflow_dispatch:
    inputs:
      asin:
        description: "Force a specific ASIN (overrides random pool selection). Caller must have already deleted any existing data/articles/*-<ASIN>.json before dispatching."
        required: false
        default: ""

# 2026-05-17 Step C-1: 1 run = 1 ASIN から 1 run = 最大 8 ASIN へ並列化。
# - concurrency: invoke-jules は外す (jules-lock/<ASIN> branch が atomic 排他を担う)
# - check-open-prs ガードも外す (open PR でも別 ASIN なら lock 取得時点で衝突しない)
# - pick-asin は 8 件 lock 取れるまで loop、後続 step は bash for-loop で 8 ASIN 分回す
# Step C-2 (lock branch) と組み合わせて inter-run race を防ぎつつスループット 8x を狙う。

jobs:
  invoke-jules:
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      # 2026-05-15: B 段階対策。事故 PR #185-189 は Jules が `amazon.json` の items[0]
      # (= B0DT15VQF8) を毎回選んでいたことが原因。workflow 側で候補を計算し
      # (articles 既存 + open PR 内 ASIN を除外)、ランダムに 1 件選んで prompt に明示する。
      - name: Pick next ASIN
        id: pick-asin
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          INPUT_ASIN: ${{ github.event.inputs.asin }}
        run: |
          set -e
          REPO=${{ github.repository }}
          gh pr list --repo $REPO --state open --json title \
            --jq '.[].title' > /tmp/open_titles.txt || echo "" > /tmp/open_titles.txt
          # 既存 lock ブランチ (jules-lock/<ASIN>) を exclusion に追加。
          # 2026-05-17 Step C-2: inter-run race (前 run の Jules セッションが PR 出す前に
          # 次 run が同 ASIN を picking) を防ぐ。lock ブランチは ref 作成が atomic (422 on conflict)。
          gh api "repos/$REPO/git/matching-refs/heads/jules-lock/" \
            --jq '.[] | .ref | sub("refs/heads/jules-lock/"; "")' > /tmp/locked.txt 2>/dev/null || echo "" > /tmp/locked.txt
          python3 - <<'PY'
          import json, re, glob, os, random
          input_asin = os.environ.get('INPUT_ASIN', '').strip()
          _ASIN_RE = re.compile(r'^B0[A-Z0-9]{8}$')
          if input_asin:
              # 2026-05-18: workflow_dispatch.inputs.asin で個別 ASIN を強制指定するケース。
              # ランダム pool 選定をバイパスし、指定 ASIN 1 件のみを shuffled.txt に書く。
              # existing-article / open-PR の除外も skip (再生成用途を想定し、呼び出し側で削除済み前提)。
              # lock 取得は通常ロジックを通すので、既に lock があれば失敗する (atomic 保証は維持)。
              if not _ASIN_RE.match(input_asin):
                  raise SystemExit(f"INPUT_ASIN '{input_asin}' does not match B0[A-Z0-9]{{8}}")
              print(f"Using forced ASIN from workflow_dispatch input: {input_asin}")
              with open('/tmp/shuffled.txt', 'w') as f:
                  f.write(input_asin + '\n')
          else:
              with open('data/raw/amazon.json', encoding='utf-8') as f:
                  raw = json.load(f)
              items = raw.get('items', [])
              # 2026-05-17: candidates は B0[A-Z0-9]{8} 形式 (Amazon 標準 ASIN) のみに絞る。
              # PR #279 で書籍/JAN 形式 ASIN (例 4910762175) が pick されてしまい、
              # 06-jules-lock-cleanup.yml の release-on-merge regex (B0...) にも一致せず
              # lock が schedule TTL まで残る事故が発生した。
              candidates = [
                  i['asin'] for i in items
                  if isinstance(i, dict) and isinstance(i.get('asin'), str)
                  and _ASIN_RE.match(i['asin'])
              ]
              existing = set()
              for path in glob.glob('data/articles/*.json'):
                  base = os.path.basename(path)
                  if base.endswith('.enrichment.json') or base.endswith('.quality.json'):
                      continue
                  m = re.search(r'(B0[A-Z0-9]{8})', base)
                  if m:
                      existing.add(m.group(1))
              for fname in ('/tmp/open_titles.txt', '/tmp/locked.txt'):
                  try:
                      with open(fname, encoding='utf-8') as f:
                          for line in f:
                              for m in re.finditer(r'(B0[A-Z0-9]{8})', line):
                                  existing.add(m.group(1))
                  except FileNotFoundError:
                      pass
              remaining = [a for a in candidates if a not in existing]
              print(f"candidates={len(candidates)} existing_excluded={len(existing)} remaining={len(remaining)}")
              # GITHUB_RUN_ID で seed してシャッフル。bash 側で 1 件ずつ lock 試行 → 取得成功した時点で確定
              rng = random.Random(os.environ.get('GITHUB_RUN_ID', ''))
              rng.shuffle(remaining)
              with open('/tmp/shuffled.txt', 'w') as f:
                  for a in remaining:
                      f.write(a + '\n')
          PY
          # lock ブランチ用の empty commit を作る (committer.date を TTL 判定に利用)
          # 2026-05-17 Step C-1: MAX_LOCKS まで lock を取得し、picked.txt に列挙する。
          MAX_LOCKS=8
          MAIN_SHA=$(gh api repos/$REPO/git/refs/heads/main --jq .object.sha)
          MAIN_TREE=$(gh api repos/$REPO/git/commits/$MAIN_SHA --jq .tree.sha)
          : > /tmp/picked.txt
          ACQUIRED=0
          while IFS= read -r asin; do
            [ -z "$asin" ] && continue
            [ "$ACQUIRED" -ge "$MAX_LOCKS" ] && break
            TS=$(date -u +%FT%TZ)
            COMMIT=$(jq -n --arg msg "jules-lock $asin" --arg tree "$MAIN_TREE" --arg parent "$MAIN_SHA" --arg ts "$TS" \
              '{message: $msg, tree: $tree, parents: [$parent], author: {name: "github-actions", email: "actions@github.com", date: $ts}, committer: {name: "github-actions", email: "actions@github.com", date: $ts}}' | \
              gh api -X POST "repos/$REPO/git/commits" --input - --jq .sha 2>/dev/null)
            [ -z "$COMMIT" ] && continue
            if gh api -X POST "repos/$REPO/git/refs" \
                -f ref="refs/heads/jules-lock/$asin" -f sha="$COMMIT" >/dev/null 2>&1; then
              echo "Lock acquired: jules-lock/$asin"
              echo "$asin" >> /tmp/picked.txt
              ACQUIRED=$((ACQUIRED + 1))
            else
              echo "Lock contention on $asin, trying next"
            fi
          done < /tmp/shuffled.txt
          echo "Locks acquired: $ACQUIRED / target $MAX_LOCKS"
          if [ "$ACQUIRED" -eq 0 ]; then
            echo "::warning::No candidate ASINs available (all excluded/locked)"
            echo "count=0" >> $GITHUB_OUTPUT
            echo "asins=" >> $GITHUB_OUTPUT
          else
            ASINS_CSV=$(paste -sd, /tmp/picked.txt)
            echo "count=$ACQUIRED" >> $GITHUB_OUTPUT
            echo "asins=$ASINS_CSV" >> $GITHUB_OUTPUT
            echo "chosen=$ASINS_CSV"
          fi

      # Step 1: ソースを確認 (全 ASIN で共通の source_name)
      - name: List Jules Sources
        if: steps.pick-asin.outputs.count != '0'
        id: list-sources
        run: |
          echo "=== Listing Jules Sources ==="
          RESPONSE=$(curl -s -w "\n%{http_code}" \
            'https://jules.googleapis.com/v1alpha/sources' \
            -H "X-Goog-Api-Key: ${{ secrets.JULES_API_KEY }}")
          HTTP_CODE=$(echo "$RESPONSE" | tail -1)
          BODY=$(echo "$RESPONSE" | sed '$d')
          echo "HTTP: $HTTP_CODE"
          echo "$BODY" | head -20
          if [ "$HTTP_CODE" != "200" ]; then
            echo "::error::Failed to list sources (HTTP $HTTP_CODE)"
            exit 1
          fi
          # 2026-05-13: ハイフン形式は NOT_FOUND と判明したのでスラッシュ形式に戻す
          # (List API が返す .name フィールドをそのまま使うのが正解)
          SOURCE_NAME=$(echo "$BODY" | jq -r '.sources[] | select(.githubRepo.owner=="omochairo" and .githubRepo.repo=="amazon") | .name' 2>/dev/null || echo "")
          if [ -z "$SOURCE_NAME" ]; then
            echo "::warning::Source not found, using default"
            SOURCE_NAME="sources/github/omochairo/amazon"
          fi
          echo "source_name=$SOURCE_NAME" >> $GITHUB_OUTPUT
          echo "Source: $SOURCE_NAME"

      # Step 2: セッション作成 (picked.txt の全 ASIN 分ループ)
      - name: Create Jules Sessions
        id: create-sessions
        if: steps.pick-asin.outputs.count != '0'
        env:
          ASINS_CSV: ${{ steps.pick-asin.outputs.asins }}
          SOURCE_NAME: ${{ steps.list-sources.outputs.source_name }}
        run: |
          # 2026-05-17: Jules が date/slug を未来日付でハルシネートする事故
          # (filename 2026-05-25, 実生成 5/14 ≒ +11日先 等 / posts/2026-05-25-b0fx3qbqbf)
          # への対策として、本日 (Asia/Tokyo) を明示的に注入する。
          # Hugo サイトは JST 表示なので date フィールドも +09:00 で揃える。
          TODAY=$(TZ=Asia/Tokyo date +%Y-%m-%d)
          TODAY_ISO=${TODAY}T10:00:00+09:00
          : > /tmp/session_ids.txt
          OK=0
          FAIL=0
          IFS=',' read -ra ASIN_ARR <<< "$ASINS_CSV"
          for TARGET_ASIN in "${ASIN_ARR[@]}"; do
            [ -z "$TARGET_ASIN" ] && continue
            echo "=== Creating Jules Session (target: $TARGET_ASIN, today: $TODAY) ==="
            # 2026-05-13: 12行のハードコードプロンプトを廃止し、jules/PROMPT_TEMPLATE.md
            # を読み込む形に変更（記事品質向上のため出典・競合比較・cross-check ルールを
            # フルプロンプトとして渡す）。
            # 2026-05-15: 対象 ASIN を workflow 側で事前選定して prompt に明示注入する形に変更
            # （事故 PR #185-189 = 全 5 件 B0DT15VQF8 の再発防止）。
            # ※ FAILED_PRECONDITION が再発した場合は memory:
            # feedback_jules_api_failed_precondition.md を参照し、まず API キー再発行を試す。
            INTRO="AGENTS.md を最初に必ず読み、その指示に厳密に従ってください。
            以下は STAGE 1 (記事JSON生成) の詳細プロンプトです。出典・競合比較・cross-check のルールを必ず守ってください。

            【今回生成する記事の対象 ASIN】: ${TARGET_ASIN}
            このセッションで生成する記事は必ずこの ASIN を対象としてください。他の ASIN は選ばないでください。

            【本日の日付 (必ず使用)】: ${TODAY}
            - 出力ファイル名: data/articles/${TODAY}-${TARGET_ASIN}.json
            - slug フィールド: \"${TODAY}-${TARGET_ASIN}\"
            - date フィールド: \"${TODAY_ISO}\"
            PROMPT_TEMPLATE.md のスキーマ例にある日付 (2026-05-12 等) はあくまで例示なので絶対に流用しないでください。未来日付・過去日付の生成は禁止です。

            絶対守るリポジトリ保護ルール:
            - 新規ファイル追加のみ。既存ファイルの変更・削除は禁止
            - .github/, scripts/, hugo/ への変更は禁止
            - data/articles/ フォルダへの JSON 追加のみ許可（命名: ${TODAY}-${TARGET_ASIN}.json 固定）
            - **最終 PR の差分は data/articles/${TODAY}-${TARGET_ASIN}.json の追加 1 ファイルのみ**。
              ワークスペース内で fix_*.py / tmp_*.py / debug_*.py / scratch_*.json などの一時スクリプト・
              中間ファイルを作って JSON を整形するのは構わないが、それらは **必ず最終コミット前に削除し PR に含めないこと**。
              article JSON 以外がコミットされていると 05-jules-auto-merge の scope ガードが eligible=false にして
              auto-merge を停止する（PR #301 の事故事例）。
            - data/raw/amazon.json から対象 ASIN (${TARGET_ASIN}) のエントリを読み込んで記事を生成
            - 楽天/Yahoo の価格・URL は **必ず data/raw/rakuten_matched.json および data/raw/yahoo_matched.json** から
              matched_asin == \"${TARGET_ASIN}\" のエントリを参照し、product.prices.rakuten / product.prices.yahoo に
              { price, url } を埋め込む。マッチが無ければ price=0 / url=\"\" / is_search=true で良い。
              data/raw/rakuten.json と data/raw/yahoo_result.json はキーワード検索結果でありASIN単位のマッチではないため
              価格欄には**使わない**こと (sources の補助情報としては可)。
            - data/raw/youtube.json および data/raw/per_asin/${TARGET_ASIN}/ 配下の補助データも活用する

            === 以下、jules/PROMPT_TEMPLATE.md の内容 ==="
            PROMPT="$INTRO

            $(cat jules/PROMPT_TEMPLATE.md)"

            REQUEST_BODY=$(jq -n \
              --arg prompt "$PROMPT" \
              --arg source "$SOURCE_NAME" \
              '{
                prompt: $prompt,
                sourceContext: {
                  source: $source,
                  githubRepoContext: {
                    startingBranch: "main"
                  }
                },
                automationMode: "AUTO_CREATE_PR",
                title: "記事生成: 商品深掘りガイド"
              }')

            RESPONSE=$(curl -s -w "\n%{http_code}" \
              'https://jules.googleapis.com/v1alpha/sessions' \
              -X POST \
              -H "Content-Type: application/json" \
              -H "X-Goog-Api-Key: ${{ secrets.JULES_API_KEY }}" \
              -d "$REQUEST_BODY")
            HTTP_CODE=$(echo "$RESPONSE" | tail -1)
            BODY=$(echo "$RESPONSE" | sed '$d')
            echo "HTTP: $HTTP_CODE"
            echo "$BODY" | jq -c '{name, id, status}' 2>/dev/null || echo "$BODY" | head -c 500
            if [ "$HTTP_CODE" != "200" ]; then
              echo "::warning::Failed to create session for $TARGET_ASIN (HTTP $HTTP_CODE)"
              # FAILED_PRECONDITION が出たら memory: feedback_jules_api_failed_precondition.md
              # 参照 → 最優先で API キーを再発行 (jules.google.com → Settings → API keys)
              FAIL=$((FAIL + 1))
              continue
            fi
            SESSION_ID=$(echo "$BODY" | jq -r '.id // empty')
            if [ -z "$SESSION_ID" ]; then
              echo "::warning::No session id returned for $TARGET_ASIN"
              FAIL=$((FAIL + 1))
              continue
            fi
            echo "${TARGET_ASIN}:${SESSION_ID}" >> /tmp/session_ids.txt
            OK=$((OK + 1))
            echo "Session created: $TARGET_ASIN -> $SESSION_ID"
          done
          echo "Sessions: OK=$OK FAIL=$FAIL"
          echo "count_ok=$OK" >> $GITHUB_OUTPUT
          echo "count_fail=$FAIL" >> $GITHUB_OUTPUT
          if [ "$OK" -eq 0 ]; then
            echo "::error::No Jules sessions were created"
            exit 1
          fi

      # Step 3: セッション状態確認 (全 session を順次 poll、最大5分の smoke test)
      # AUTO_CREATE_PR は非同期で完了するため、ここでの完了待ちは目視/早期エラー検知用。
      - name: Wait for Jules completions
        if: steps.create-sessions.outputs.count_ok != '0'
        run: |
          declare -a LINES
          while IFS= read -r line; do
            [ -z "$line" ] && continue
            LINES+=("$line")
          done < /tmp/session_ids.txt
          TOTAL=${#LINES[@]}
          echo "=== Monitoring $TOTAL sessions ==="
          for i in $(seq 1 10); do
            sleep 30
            DONE=0
            for line in "${LINES[@]}"; do
              ASIN="${line%%:*}"
              SESSION_ID="${line#*:}"
              RESPONSE=$(curl -s \
                "https://jules.googleapis.com/v1alpha/sessions/$SESSION_ID" \
                -H "X-Goog-Api-Key: ${{ secrets.JULES_API_KEY }}")
              STATUS=$(echo "$RESPONSE" | jq -r '.status // "unknown"')
              echo "[$i/10] $ASIN ($SESSION_ID): $STATUS"
              if [ "$STATUS" = "COMPLETED" ] || [ "$STATUS" = "FAILED" ]; then
                DONE=$((DONE + 1))
              fi
            done
            if [ "$DONE" -eq "$TOTAL" ]; then
              echo "All $TOTAL sessions reached terminal state"
              break
            fi
          done
          echo "Polling complete (best-effort; AUTO_CREATE_PR continues async)"
</file>

<file path=".github/workflows/05-jules-auto-merge.yml">
name: Jules PR Auto-Merge
on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review]
    paths:
      - 'data/articles/**.json'

permissions:
  contents: write
  pull-requests: write
  # 2026-05-18: workflow_dispatch event 作成 (Wait for merge and dispatch publish step) のため必須。
  # 不足すると PR MERGED 検知後の `gh workflow run "Jules Publish Pipeline"` が
  # HTTP 403 "Resource not accessible by integration" で失敗する。
  # 同 token 制約は 01-fetch-products.yml の PR #287 で経験済。
  actions: write

concurrency:
  group: jules-auto-merge-${{ github.event.pull_request.number }}
  cancel-in-progress: false

jobs:
  enable-auto-merge:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Inspect changed files
        id: scope
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          set -e
          # Triple-dot: diff from merge-base of BASE and HEAD to HEAD.
          # Excludes changes landed on main after this branch diverged so the
          # scope guard sees only what *this PR* added/modified.
          changed=$(git diff --name-only "$BASE_SHA"..."$HEAD_SHA")
          echo "Changed files:"
          echo "$changed"
          # Safety: every changed file must be under data/articles/ or data/raw/per_asin/
          out_of_scope=$(echo "$changed" | grep -v -E '^(data/articles/|data/raw/per_asin/)' || true)
          if [ -n "$out_of_scope" ]; then
            echo "PR touches files outside data/articles/ or data/raw/per_asin/; skipping auto-merge."
            echo "out_of_scope<<EOF" >> "$GITHUB_OUTPUT"
            echo "$out_of_scope" >> "$GITHUB_OUTPUT"
            echo "EOF" >> "$GITHUB_OUTPUT"
            echo "eligible=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          # Must add or modify at least one data/articles/B0XXXXXXXX.json
          added=$(git diff --name-only --diff-filter=AM "$BASE_SHA"..."$HEAD_SHA" \
                    -- 'data/articles/*.json' \
                  | grep -v '\.quality\.json$' \
                  | grep -E 'data/articles/[0-9]{4}-[0-9]{2}-[0-9]{2}-B0[A-Z0-9]{8}\.json$' || true)
          if [ -z "$added" ]; then
            echo "No Jules-shaped article JSON added; skipping auto-merge."
            echo "eligible=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "Jules-eligible article JSON(s):"
          echo "$added"
          echo "eligible=true" >> "$GITHUB_OUTPUT"

      - name: Enable native auto-merge (squash)
        if: steps.scope.outputs.eligible == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_URL: ${{ github.event.pull_request.html_url }}
        run: |
          set -e
          # gh requires branch protection / rulesets with a required check to honor --auto.
          # See PR description for the one-time `gh api` setup snippet.
          if gh pr merge --auto --squash --delete-branch "$PR_URL"; then
            echo "Auto-merge (squash + delete-branch) enabled on $PR_URL."
          else
            echo "::warning::Could not enable auto-merge. This usually means branch protection or repo-level 'Allow auto-merge' is not configured. PR will need manual merge until setup is complete."
          fi

      # 2026-05-17 Step C-3: auto-merge を有効化した時点で jules-lock/<ASIN> を即時解放する。
      # 06-jules-lock-cleanup.yml の pull_request:closed トリガは
      # GITHUB_TOKEN 起因の merge では発火しない (GitHub Actions の既知制約) ため、
      # 05 側で能動的に削除する。失敗しても 06 schedule (30 分毎・TTL 1h) で回収されるので非致命。
      # 安全性: この時点で Jules PR が open 状態で存在し、03-invoke-jules.yml の pick-asin が
      # /tmp/open_titles.txt でも ASIN を除外するため、lock を消しても同 ASIN の再 pick は起きない。
      - name: Release jules-lock branch
        if: steps.scope.outputs.eligible == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_TITLE: ${{ github.event.pull_request.title }}
          HEAD_REF: ${{ github.event.pull_request.head.ref }}
          REPO: ${{ github.repository }}
        run: |
          set -e
          # ASIN は PR タイトル → head branch 名 (小文字混在可) の順で抽出
          ASIN=$(echo "$PR_TITLE" | grep -oE 'B0[A-Z0-9]{8}' | head -1 || true)
          if [ -z "$ASIN" ]; then
            ASIN=$(echo "$HEAD_REF" | grep -oiE 'b0[a-z0-9]{8}' | head -1 | tr '[:lower:]' '[:upper:]' || true)
          fi
          if [ -z "$ASIN" ]; then
            echo "No ASIN found in PR title or head ref; skipping lock release"
            exit 0
          fi
          if gh api -X DELETE "repos/$REPO/git/refs/heads/jules-lock/$ASIN" 2>/dev/null; then
            echo "Released lock: jules-lock/$ASIN"
          else
            echo "No lock to release for $ASIN (already cleaned up or never existed)"
          fi

      # 2026-05-18: GITHUB_TOKEN による auto-merge は push event cascade を発火しない
      # (GHA 既知制約 — 無限ループ防止のため) ため、02-publish.yml の
      # `push: paths: data/articles/**` トリガが起動しない。
      # 対策: ここで PR が実際に MERGED になるまで polling し、
      # 検知したら workflow_dispatch で publish を明示起動する。
      # workflow_dispatch は GHA cascade 制約の数少ない例外として GITHUB_TOKEN
      # 経由でも下流ワークフローを起動できる。
      - name: Wait for merge and dispatch publish
        if: steps.scope.outputs.eligible == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          REPO: ${{ github.repository }}
        run: |
          set -e
          # validate (~30s) + auto-merge (~10s) で通常 30-60s。6 分 (15s × 24) で十分なゆとり。
          MAX_ATTEMPTS=24
          attempt=0
          while [ $attempt -lt $MAX_ATTEMPTS ]; do
            state=$(gh pr view "$PR_NUMBER" -R "$REPO" --json state --jq '.state' || echo "UNKNOWN")
            echo "Attempt $((attempt+1))/$MAX_ATTEMPTS: PR #$PR_NUMBER state=$state"
            if [ "$state" = "MERGED" ]; then
              echo "PR merged. Dispatching Jules Publish Pipeline."
              gh workflow run "Jules Publish Pipeline" -R "$REPO" --ref main
              echo "Dispatched."
              exit 0
            fi
            if [ "$state" = "CLOSED" ]; then
              echo "PR closed without merge. Skipping publish dispatch."
              exit 0
            fi
            attempt=$((attempt+1))
            sleep 15
          done
          echo "::warning::PR #$PR_NUMBER did not reach MERGED within timeout. Publish must be dispatched manually: gh workflow run \"Jules Publish Pipeline\" --ref main"
</file>

<file path=".github/workflows/06-jules-lock-cleanup.yml">
name: Jules Lock Cleanup
# 2026-05-17 Step C-2: lock ブランチ (jules-lock/<ASIN>) のライフサイクル管理
# - schedule (30分毎): committer.date が 1h 以上前の stale lock を削除 (Jules セッション失敗時の救済)
# - pull_request closed (merged): merge 済 Jules PR の lock を即時解放
# - workflow_dispatch: 手動 cleanup
on:
  schedule:
    - cron: '*/30 * * * *'
  pull_request:
    types: [closed]
  workflow_dispatch:

jobs:
  release-on-merge:
    if: github.event_name == 'pull_request' && github.event.pull_request.merged == true
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Release lock for merged Jules PR
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_TITLE: ${{ github.event.pull_request.title }}
        run: |
          ASIN=$(echo "$PR_TITLE" | grep -oE 'B0[A-Z0-9]{8}' | head -1 || true)
          if [ -z "$ASIN" ]; then
            echo "PR title has no ASIN; skipping"
            exit 0
          fi
          if gh api -X DELETE "repos/${{ github.repository }}/git/refs/heads/jules-lock/$ASIN" 2>/dev/null; then
            echo "Released lock: jules-lock/$ASIN"
          else
            echo "No lock to release for $ASIN (already cleaned up)"
          fi

  cleanup-stale:
    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Delete stale lock branches (committer.date > 1h)
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -e
          REPO=${{ github.repository }}
          TTL_SECONDS=3600
          NOW=$(date -u +%s)
          gh api "repos/$REPO/git/matching-refs/heads/jules-lock/" \
            --jq '.[] | .ref' > /tmp/locks.txt 2>/dev/null || echo "" > /tmp/locks.txt
          DELETED=0
          KEPT=0
          while IFS= read -r ref; do
            [ -z "$ref" ] && continue
            SHA=$(gh api "repos/$REPO/git/$ref" --jq '.object.sha' 2>/dev/null || echo "")
            [ -z "$SHA" ] && continue
            COMMIT_DATE=$(gh api "repos/$REPO/git/commits/$SHA" --jq '.committer.date' 2>/dev/null || echo "")
            [ -z "$COMMIT_DATE" ] && continue
            COMMIT_EPOCH=$(date -u -d "$COMMIT_DATE" +%s)
            AGE=$((NOW - COMMIT_EPOCH))
            BRANCH=$(echo "$ref" | sed 's|refs/heads/||')
            if [ "$AGE" -gt "$TTL_SECONDS" ]; then
              echo "Deleting stale $BRANCH (age ${AGE}s)"
              gh api -X DELETE "repos/$REPO/git/$ref" >/dev/null 2>&1 && DELETED=$((DELETED + 1)) || echo "  delete failed"
            else
              echo "Keeping $BRANCH (age ${AGE}s)"
              KEPT=$((KEPT + 1))
            fi
          done < /tmp/locks.txt
          echo "Summary: deleted=$DELETED kept=$KEPT"
</file>

