{#-
  Hugo Markdown template for おもちゃいろ v4.2.
  Target: 20〜40代女性。語り口は落ち着いた女性誌調。
  SEO: 商品名を H1 / 複数の H2 / 本文中に自然に配置。
  v4.2 (2026-05-14):
    - Hero score block / 3-platform CTA cards / Pros-Cons 2-col / Competitor cards
    - セクション見出しに絵文字 (📦 💴 🌟 💭 🆚 💡 📚 等 / β v5.0 で 🛒→💴 / ⭐→🌟 / 🥊→🆚 / 🎯→💡 / 🔍→📚)
    - sources URL の自動アフィリエイト化 (Amazon: tag付与, 楽天/Yahoo はそのまま透過)
  Inputs:
    title, meta_description, date, tags, keywords, persona_fit, narrative, faq, product, youtube_embeds, news, books, internal_links, editorial_comment,
    amazon_partner_tag (AMAZON_PARTNER_TAG secret 由来。affiliate_url マクロと competitor-card の Amazon CTA 既定が参照する SSOT。build_post.py が注入する)
  Optional enrichment (merged at build time):
    review_summary, use_case_scenarios, competitive_position, gift_reaction_prediction, expert_take
  Optional seo (merged at build time):
    h2_recommendations, faq_extended, jsonld_*, breadcrumbs
-#}
{%- macro affiliate_url(url) -%}
{%- if url -%}
{%- if 'amazon.co.jp' in url and 'tag=' not in url -%}
{{ url }}{{ '&' if '?' in url else '?' }}tag={{ amazon_partner_tag }}
{%- else -%}
{{ url }}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}
{#- δ-A: narrative section が string なら従来描画、array なら段落分割 -#}
{%- macro narrative_section(v) -%}
{%- if v is string -%}
{{ v }}
{%- elif v is iterable -%}
{% for p in v %}{{ p }}

{% endfor %}
{%- endif -%}
{%- endmacro -%}
{#- Issue #515: 各 EC 価格カード右上に置く「リンクが違う？」報告フラグ。
    GitHub Issue Forms (.github/ISSUE_TEMPLATE/link_report.yml) を URL params で
    pre-fill しつつ別タブで開く。-#}
{%- macro link_report_flag(ec_site, wrong_url) -%}
{%- set article_url = 'https://navi.omcha.jp/posts/' ~ (slug|lower) ~ '/' -%}
{%- set title_default = '[link-report] ' ~ product.asin ~ ' ' ~ ec_site ~ ' のリンクが違う' -%}
<a class="link-report-flag" href="https://github.com/omochairo/amazon/issues/new?template=link_report.yml&title={{ title_default|urlencode }}&article_url={{ article_url|urlencode }}&asin={{ product.asin|urlencode }}&ec_site={{ ec_site|urlencode }}&wrong_url={{ (wrong_url or '')|urlencode }}" target="_blank" rel="noopener nofollow" title="このリンクが違うと報告" aria-label="{{ ec_site }} のリンクを誤報告">🚩</a>
{%- endmacro -%}
<aside class="auto-gen-notice"><span class="pr-badge">[PR]</span><span class="auto-gen-notice-text">おもちゃロボが市場データから自動生成しています。</span></aside>

{#- 販売終了 notice (2026-07-07): build_post._apply_amazon_discontinued が
    snapshot status=gone かつ 楽天/Yahoo にも直リンク無しのとき
    purchase_unavailable=True を立てる。-#}
{% if purchase_unavailable %}
<aside class="discontinued-notice">🚫 <strong>この商品は現在、Amazon・楽天・Yahoo!ショッピングで販売ページを確認できません。</strong>販売終了または取り扱い停止の可能性があります。記事内の価格・仕様は執筆時点の情報です。{% if competitive_analysis %}<a href="#alternatives">類似のおすすめ商品を見る ↓</a>{% endif %}</aside>
{% endif %}

{#- #2686 / #4964: 「どこで買える/在庫」記事型。build_post.py が
    where_to_buy_format.build_stock_block() で決定的に組み立てた
    stock_where_to_buy がある記事だけ、結論ブロック→在庫テーブル→
    価格推移メモ→品薄サイン→実店舗注記を記事冒頭に出す。
    この型が付かない記事 (ロールアウト日より前 / state=unknown) では
    stock_where_to_buy は None のままなので、既存記事の描画は一切変化しない。 -#}
{% if stock_where_to_buy %}
<section class="where-to-buy-block" aria-label="在庫と価格のまとめ">
<p class="where-to-buy-conclusion">{{ stock_where_to_buy.conclusion }}</p>
<div class="where-to-buy-table-wrap">
<table class="where-to-buy-table">
<thead><tr><th>販売サイト</th><th>価格</th><th>在庫状況</th><th>取得日時</th><th>リンク</th></tr></thead>
<tbody>
{% for row in stock_where_to_buy.rows %}<tr><td>{{ row.site }}</td><td>{% if row.price %}￥{{ "{:,}".format(row.price) }}{% else %}—{% endif %}</td><td>{{ row.state_label }}</td><td>{{ row.observed_at_label }}</td><td>{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener nofollow sponsored">見る →</a>{% else %}—{% endif %}</td></tr>
{% endfor %}</tbody>
</table>
</div>
{% if stock_where_to_buy.price_history_note %}<p class="where-to-buy-price-history">📉 {{ stock_where_to_buy.price_history_note }}</p>{% endif %}
{% if stock_where_to_buy.low_stock_note %}<p class="where-to-buy-low-stock">{{ stock_where_to_buy.low_stock_note }}</p>{% endif %}
<p class="where-to-buy-offline-note"><small>{{ stock_where_to_buy.offline_note }}</small></p>
</section>
{% endif %}

{% if product.name_full and product.name_full != product.name %}
<p class="product-full-name">正式商品名：<strong>{{ product.name_full }}</strong></p>
{% endif %}
{% if product.image %}
<figure class="product-hero-image"><img src="{{ product.image }}" alt="{{ product.name }}の商品画像"{% if product.image_width and product.image_height %} width="{{ product.image_width }}" height="{{ product.image_height }}"{% endif %} fetchpriority="high" decoding="async"><figcaption>出典：Amazon商品ページ</figcaption></figure>
{% endif %}

{% if narrative.lead %}{{ narrative.lead }}{% endif %}

{# ===== Hero score block (β v5.1): 総合スコア棒グラフ + 4軸レーダー + verdict + pros/cons =====
   #1111: data["score"] (build_post._build_score_context が ScoreResult から構築) を参照する。
   旧 product.ivs_detail.* は廃止 (Phase 2/3 完了 = _sync_ivs_for_render 削除済)。 #}
{% if score %}
<div class="hero-score">
<div class="hero-total-row">
<div class="hero-total-badge"><span class="hero-total-label">🌟 知育スコア</span><span class="hero-total-value">{{ score.total_100 }}<small>/100</small></span></div>
{% if verdict and verdict.headline %}<p class="hero-verdict">「{{ verdict.headline }}」</p>{% endif %}
</div>
<div class="hero-total-bar" aria-label="知育スコア（総合）の棒グラフ">
<div class="hero-total-bar-track"><div class="hero-total-bar-fill" style="--bar-w:{{ score.total_100 }}%"><span class="hero-total-bar-value">{{ score.total_100 }} / 100 点</span></div></div>
<p class="hero-total-bar-caption">下のレーダー 4 軸（📚 知育効果 / 🕰️ 長く遊べる / 🛡️ 安全性 / 💰 コスパ）を加重平均し、100 点満点に換算したおもちゃロボ独自の総合スコアです。</p>
</div>
<div class="hero-radar" aria-label="4軸スコアのレーダーチャート（上=コスパ・下=長く遊べる・左=知育効果・右=安全性）">
<svg viewBox="0 0 400 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="false">
<g class="radar-grid"><polygon points="200,50 290,140 200,230 110,140"/><polygon points="200,80 260,140 200,200 140,140"/><polygon points="200,110 230,140 200,170 170,140"/></g>
<g class="radar-axes"><line x1="200" y1="50" x2="200" y2="230"/><line x1="110" y1="140" x2="290" y2="140"/></g>
<polygon class="radar-shape" points="{{ score.radar_points }}"/>
<g class="radar-labels" font-size="14"><text x="200" y="22" text-anchor="middle">💰 コスパ<tspan x="200" dy="1.25em">{{ "%.1f"|format(score.cost_performance) }}/5.0</tspan></text><text x="298" y="136" text-anchor="start">🛡️ 安全性<tspan x="298" dy="1.25em">{{ "%.1f"|format(score.safety) }}/5.0</tspan></text><text x="200" y="246" text-anchor="middle">🕰️ 長く遊べる<tspan x="200" dy="1.25em">{{ "%.1f"|format(score.longevity) }}/5.0</tspan></text><text x="102" y="136" text-anchor="end">📚 知育効果<tspan x="102" dy="1.25em">{{ "%.1f"|format(score.education) }}/5.0</tspan></text></g>
</svg>
</div>
{% if (product.pros and product.pros|length) or (product.cons and product.cons|length) %}
<div class="hero-pros-cons">
<div class="hero-pros"><strong>👍 良いところ</strong><ul>{% for p in product.pros[:3] %}<li>{{ p }}</li>{% endfor %}</ul></div>
<div class="hero-cons"><strong>⚠️ 気になるところ</strong><ul>{% for c in product.cons[:3] %}<li>{{ c }}</li>{% endfor %}</ul></div>
</div>
{% endif %}
<div class="hero-meta">
{% if persona_fit and persona_fit.age_range %}<div class="hero-meta-row">💡 対象年齢：<strong>{{ persona_fit.age_range }}</strong></div>{% endif %}
{% if product.best_price > 0 %}<div class="hero-meta-row">🏷️ 最新観測時点の最安値：<strong>￥{{ "{:,}".format(product.best_price) }}</strong>（{{ product.best_platform }}）</div>{% endif %}
</div>
</div>
{% endif %}

{% if persona_fit %}
<aside class="persona-fit"><strong>この記事はこんな方へ</strong><ul>{% for r in persona_fit.recommended_for %}<li>{{ r }}</li>{% endfor %}</ul>{% if persona_fit.not_recommended_for %}<div class="persona-fit__caution"><strong>🤔 逆に、こんな方は別の商品も検討を</strong><ul>{% for n in persona_fit.not_recommended_for %}<li>{{ n }}</li>{% endfor %}</ul></div>{% endif %}{% if persona_fit.age_range %}<p>対象年齢：<strong>{{ persona_fit.age_range }}</strong></p>{% endif %}</aside>
{% endif %}

{% if development_stage %}
<details class="development-stage-accordion">
<summary>👶 このおもちゃの対象年齢（{{ development_stage.age_label }}）における発達の目安を見る</summary>
<div class="development-stage-content">
<p><strong>🧠 発達の特徴（認知・運動）：</strong><br>{{ development_stage.developmental_features }}</p>
<p><strong>🎯 知育の目的と効果：</strong><br>{{ development_stage.educational_goals }}</p>
<p><strong>🧸 おすすめの遊び方と関わり方：</strong><br>{{ development_stage.recommended_toys }}</p>
<small class="development-stage-source">※WHO（世界保健機関）や文部科学省の乳幼児発達指針等を基に作成しています。発達のペースには個人差があります。</small>
</div>
</details>
{% endif %}

{% set price_comparison_md -%}
## <small>{{ product.name }}の</small>💴 価格を3サイトで比較

当サイトが自動観測した最新価格をAmazon・楽天・Yahoo!ショッピングで横断比較しました。

{% set is_amazon_best = product.prices.amazon.price > 0 and product.prices.amazon.price == product.best_price %}
{% set is_rakuten_best = product.prices.rakuten.price > 0 and product.prices.rakuten.price == product.best_price %}
{% set is_yahoo_best = product.prices.yahoo.price > 0 and product.prices.yahoo.price == product.best_price %}
<div class="price-cta-grid">
{% set amazon_stock = product.prices.amazon.availability|amazon_stock_state %}
{% set amazon_effective = product.prices.amazon.price - product.prices.amazon.loyalty_points if (product.prices.amazon.price > 0 and product.prices.amazon.loyalty_points and product.prices.amazon.loyalty_points >= 50) else 0 %}
<div class="price-card{% if is_amazon_best %} is-cheapest{% endif %}{% if amazon_stock == 'outofstock' or product.prices.amazon.discontinued %} is-outofstock{% endif %}">{{ link_report_flag('Amazon', product.prices.amazon.url) }}<div class="price-card-label">Amazon</div><div class="price-card-amount">{% if product.prices.amazon.discontinued %}<span class="price-card-tbd">取り扱い終了</span>{% elif product.prices.amazon.price > 0 %}￥{{ "{:,}".format(product.prices.amazon.price) }}{% else %}<span class="price-card-tbd">取り扱い確認</span>{% endif %}</div>{% if amazon_effective > 0 %}<div class="amazon-effective-price">ポイント考慮の実質 <strong>￥{{ "{:,}".format(amazon_effective) }}</strong></div>{% endif %}{% if product.prices.amazon.savings_percentage or product.prices.amazon.loyalty_points or product.prices.amazon.free_shipping or amazon_stock != 'unknown' %}<div class="amazon-badges">{% if product.prices.amazon.savings_percentage %}<span class="amazon-badge badge-discount">{{ product.prices.amazon.savings_percentage }}% OFF</span>{% endif %}{% if product.prices.amazon.loyalty_points %}<span class="amazon-badge badge-points">{{ product.prices.amazon.loyalty_points }}pt 還元</span>{% endif %}{% if amazon_stock == 'instock' %}<span class="amazon-badge badge-stock">🟢 在庫あり</span>{% elif amazon_stock == 'low_stock' %}<span class="amazon-badge badge-stock--low" title="{{ product.prices.amazon.availability }}">⚠️ 残りわずか</span>{% elif amazon_stock == 'outofstock' %}<span class="amazon-badge badge-discount">🔴 在庫切れ</span>{% elif amazon_stock == 'preorder' %}<span class="amazon-badge badge-preorder" title="{{ product.prices.amazon.availability }}">🗓️ 予約受付中</span>{% endif %}{% if product.prices.amazon.free_shipping %}<span class="amazon-badge badge-stock">🚚 送料無料</span>{% endif %}</div>{% endif %}{% if product.prices.amazon.discontinued %}{% if product.prices.amazon.search_url %}<a href="{{ product.prices.amazon.search_url }}" target="_blank" rel="noopener nofollow sponsored" class="price-card-cta price-card-cta--amazon price-card-cta--muted">Amazonで類似品を検索 →</a>{% else %}<span class="price-card-nolink">リンクなし</span>{% endif %}{% elif product.prices.amazon.url %}<a href="{{ product.prices.amazon.url }}" target="_blank" rel="noopener nofollow sponsored" class="price-card-cta price-card-cta--amazon{% if amazon_stock == 'outofstock' %} price-card-cta--muted{% endif %}">{% if amazon_stock == 'outofstock' %}再入荷を確認 →{% else %}Amazonで見る →{% endif %}</a>{% else %}<span class="price-card-nolink">リンクなし</span>{% endif %}</div>
<div class="price-card{% if is_rakuten_best %} is-cheapest{% endif %}">{{ link_report_flag('楽天市場', product.prices.rakuten.url) }}<div class="price-card-label">楽天市場</div><div class="price-card-amount">{% if product.prices.rakuten.price > 0 %}￥{{ "{:,}".format(product.prices.rakuten.price) }}{% else %}<span class="price-card-tbd">{% if product.prices.rakuten.is_search %}検索で確認{% else %}取り扱い確認{% endif %}</span>{% endif %}</div>{% if product.prices.rakuten.verified == False and not product.prices.rakuten.is_search %}<div class="price-badge-row"><span class="price-badge price-badge--unverified" title="Amazon商品と完全一致するか未確認です。クリック前に商品名と型番をご確認ください。">※確度低</span></div>{% endif %}{% if product.prices.rakuten.availability or product.prices.rakuten.free_shipping or product.prices.rakuten.asuraku %}<div class="amazon-badges">{% if product.prices.rakuten.availability %}{% if product.prices.rakuten.availability == 'instock' %}<span class="amazon-badge badge-stock">🟢 在庫あり</span>{% elif product.prices.rakuten.availability == 'outofstock' %}<span class="amazon-badge badge-discount">🔴 在庫切れ</span>{% endif %}{% endif %}{% if product.prices.rakuten.free_shipping %}<span class="amazon-badge badge-stock">🚚 送料無料</span>{% endif %}{% if product.prices.rakuten.asuraku %}<span class="amazon-badge badge-asuraku">⚡ あす楽</span>{% endif %}</div>{% endif %}{% if product.prices.rakuten.url %}<a href="{{ product.prices.rakuten.url }}" target="_blank" rel="noopener nofollow sponsored" class="price-card-cta price-card-cta--rakuten">{% if product.prices.rakuten.is_search %}楽天で検索{% else %}楽天で見る{% endif %} →</a>{% else %}<span class="price-card-nolink">リンクなし</span>{% endif %}{% if product.prices.rakuten.verified == False and product.prices.rakuten.search_url %}<div class="price-search-fallback"><a href="{{ product.prices.rakuten.search_url }}" target="_blank" rel="noopener nofollow">別商品の可能性 — 楽天で検索 →</a></div>{% endif %}</div>
<div class="price-card{% if is_yahoo_best %} is-cheapest{% endif %}">{{ link_report_flag('Yahoo!ショッピング', product.prices.yahoo.url) }}<div class="price-card-label">Yahoo!ショッピング</div><div class="price-card-amount">{% if product.prices.yahoo.price > 0 %}￥{{ "{:,}".format(product.prices.yahoo.price) }}{% else %}<span class="price-card-tbd">{% if product.prices.yahoo.is_search %}検索で確認{% else %}取り扱い確認{% endif %}</span>{% endif %}</div>{% if product.prices.yahoo.verified == False and not product.prices.yahoo.is_search %}<div class="price-badge-row"><span class="price-badge price-badge--unverified" title="Amazon商品と完全一致するか未確認です。クリック前に商品名と型番をご確認ください。">※確度低</span></div>{% endif %}{% if product.prices.yahoo.availability or product.prices.yahoo.free_shipping %}<div class="amazon-badges">{% if product.prices.yahoo.availability %}{% if product.prices.yahoo.availability == 'instock' %}<span class="amazon-badge badge-stock">🟢 在庫あり</span>{% elif product.prices.yahoo.availability == 'outofstock' %}<span class="amazon-badge badge-discount">🔴 在庫切れ</span>{% endif %}{% endif %}{% if product.prices.yahoo.free_shipping %}<span class="amazon-badge badge-stock">🚚 送料無料</span>{% endif %}</div>{% endif %}{% if product.prices.yahoo.url %}<a href="{{ product.prices.yahoo.url }}" target="_blank" rel="noopener nofollow sponsored" class="price-card-cta price-card-cta--yahoo">{% if product.prices.yahoo.is_search %}Yahoo!で検索{% else %}Yahoo!で見る{% endif %} →</a>{% else %}<span class="price-card-nolink">リンクなし</span>{% endif %}{% if product.prices.yahoo.verified == False and product.prices.yahoo.search_url %}<div class="price-search-fallback"><a href="{{ product.prices.yahoo.search_url }}" target="_blank" rel="noopener nofollow">別商品の可能性 — Yahoo!で検索 →</a></div>{% endif %}</div>
</div>
{% if price_checked_at %}
<p><small>💹 価格情報: {{ price_checked_at }} 時点</small></p>
{% endif %}
{%- if price_body_stale %}
<p class="price-body-stale-note"><small>⚠️ 本文中に書かれた価格は執筆時点のものです。その後 Amazon 側で価格が大きく変動したため、上の価格カード（最新観測値）と食い違っています。ご購入前に必ず販売ページで最新価格をご確認ください。</small></p>
{%- endif %}

{% if product.best_price > 0 %}
<div class="best-deal">💰 <strong>最新観測時点での最安値</strong>：{{ product.best_platform }} <strong class="best-deal-price">￥{{ "{:,}".format(product.best_price) }}</strong>（在庫や送料により変動する場合があります）</div>
{% endif %}

{% if product.asin %}
<div class="keepa-graph"><div class="keepa-graph-label">📈 Amazon 価格推移グラフ（Keepa 提供）</div><img src="https://graph.keepa.com/pricehistory.png?domain=co.jp&asin={{ product.asin }}" alt="{{ product.name }} の Amazon 価格推移グラフ" loading="lazy" onerror="this.closest('.keepa-graph').style.display='none'"><p>※ グラフは <a href="https://keepa.com/" target="_blank" rel="noopener nofollow">Keepa</a> によって自動生成される画像です。記事執筆後の価格変動も反映されます。</p></div>
{%- if price_history %}
