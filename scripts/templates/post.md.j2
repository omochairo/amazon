<aside class="persona-fit" style="background:#fef7f0;border-left:4px solid #ec8b5e;border-radius:8px;padding:16px 20px;margin:24px 0;color:#1f2937;"><strong style="color:#9a3412;">この記事はこんな方へ</strong><ul style="margin:8px 0 0;padding-left:20px;color:#1f2937;">{% for r in persona_fit.recommended_for %}<li style="color:#1f2937;">{{ r }}</li>{% endfor %}</ul>{% if persona_fit.age_range %}<p style="margin:8px 0 0;font-size:0.9rem;color:#1f2937;">対象年齢：<strong>{{ persona_fit.age_range }}</strong></p>{% endif %}</aside>
{% endif %}

