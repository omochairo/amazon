 fill="currentColor" opacity="0.65">{{ xl.text }}</text>{% endfor %}{% for lg in price_history.spark.legends %}<line x1="{{ lg.dash_x1 }}" y1="{{ lg.y }}" x2="{{ lg.dash_x2 }}" y2="{{ lg.y }}" stroke="currentColor" stroke-width="2"{% if lg.state == "out_of_stock" %} stroke-dasharray="1 3" stroke-linecap="round" stroke-opacity="0.35"{% else %} stroke-dasharray="3 3" stroke-opacity="0.45"{% endif %} /><text x="{{ lg.text_x }}" y="{{ lg.y }}" text-anchor="start" font-size="9" fill="currentColor" opacity="0.65">{{ lg.text }}</text>{% endfor %}</svg><details class="price-history-table"><summary>記録した{{ price_history.table_rows|length }}件の価格を表で見る</summary><table><thead><tr><th scope="col">日付</th><th scope="col">価格</th></tr></thead><tbody>{% for pt in price_history.table_rows %}<tr><td>{{ pt.date }}</td><td>¥{{ "{:,}".format(pt.price) }}</td></tr>{% endfor %}</tbody></table></details><small class="price-history-note">{% if price_history.checked_daily and price_history.change_count > 0 %}※ この{{ price_history.span_days }}日間は毎日価格を確認し、値動きを{{ price_history.change_count }}回とらえました{% if price_history.last_checked_date %}（最終確認 {{ price_history.last_checked_date }}）{% endif %}。価格が動かない期間は記録を間引いているため、点の間隔は一定ではありません。最新価格は上の各ストアでご確認ください。{% elif price_history.checked_daily %}※ この{{ price_history.span_days }}日間は毎日価格を確認しましたが、値動きはありませんでした{% if price_history.last_checked_date %}（最終確認 {{ price_history.last_checked_date }}）{% endif %}。最新価格は上の各ストアでご確認ください。{% else %}※ 本サイトが約週1回の巡回で記録した参考値です。最新価格は上の各ストアでご確認ください。{% endif %}</small></div>
{%- endif %}
