<p class="product-full-name" style="font-size:0.9rem;color:#666;margin:0 0 12px;">正式商品名：<strong>{{ product.name_full }}</strong></p>
{% endif %}
{% if product.image %}
<figure style="text-align:center;margin:0 auto 16px;display:block;width:100%;"><img src="{{ product.image }}" alt="{{ product.name }}の商品画像" loading="lazy" style="display:block;margin:0 auto;max-width:360px;width:100%;height:auto;border-radius:12px;"><figcaption style="font-size:0.85rem;color:#888;margin-top:8px;text-align:center;">出典：Amazon商品ページ</figcaption></figure>
