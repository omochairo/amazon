{{- /* #3055 E1: 全文 content/summary は /search.json (index.searchindex.json) に分離。
       ここは compare/favorites/posts一覧/term が使う軽量カタログ */ -}}
{{- /* Scratch は home の複数 output format 間で共有されキー衝突するため、ローカル変数で蓄積する */ -}}
{{- $idx := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
    {{- if and (not .Params.searchhidden) (not .Params.searchHidden) (ne .File.BaseFileName "privacy") (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- /* #2817 スラッグ移行後 .Params.tags は英語スラッグを持つため、diagnosis.js の
           JP キーワード完全一致マッチングや product-card.js / fastsearch.js の表示が
           サイレントに壊れていた (タグ由来のスコア加点が常に不発)。taxonomy 経由で
           term ページの title front matter (日本語正規名) を index.json に載せる
           (category_dropdown.html #2893 と同じ根本原因・同じ解決パターン)。 */}}
    {{- $tagNames := slice -}}
    {{- range .GetTerms "tags" }}{{ $tagNames = $tagNames | append .LinkTitle }}{{ end -}}
    {{- $idx = $idx | append (dict
        "title"        .Title
        "permalink"    .Permalink
        "image"        (.Params.product_image | default "")
        "brand"        (.Params.brand | default "")
        "brands"       (.Params.brands | default slice)
        "product_name" (.Params.product_name | default "")
        "ivs_score"    (.Params.ivs_score | default 0)
        "ivs_score_100" (.Params.ivs_score_100 | default 0)
        "ivs_axes"     (.Params.ivs_axes | default dict)
        "price_amazon" (.Params.price_amazon | default 0)
        "price_rakuten" (.Params.price_rakuten | default 0)
        "price_yahoo"  (.Params.price_yahoo | default 0)
        "date"         (.Date.Format "2006-01-02")
        "unix_time"    .Date.Unix
        "age_range"    (.Params.age_range | default "")
        "age_min_months" (.Params.age_min_months | default 0)
        "tags"         $tagNames
    ) -}}
    {{- end }}
{{- end -}}
{{- $idx | jsonify -}}
