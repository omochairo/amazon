{{- /*
  Custom sitemap (Issue #2701 / 柱0 index 健全性):
  Hugo デフォルト sitemap は noindex ページも全件出力するため、5週齢・低権威で
  クロールバジェットが極小な navi では sitemap の tags/ 2101 件のうち ~1832 件
  (<3記事の薄タグ) が noindex デッドエンドとなり、Googlebot が本命 products/
  に到達できない (= 9割未 index の主因)。

  対策: head.html の noindex 条件を mirror して sitemap から除外する。
  対象条件 (head.html と一致):
    - .Params.robotsNoIndex == true
    - 薄タグ: Kind=="term" かつ len(.Pages) < thinTermNoindexThreshold (default 3)
    - noindex ブランド: Kind=="term" かつ Data.Plural=="brands" かつ brand_hub[Title].noindex
    - 空 taxonomy: Kind=="taxonomy" かつ term ゼロ (#5343 follow-up。実測では /categories/)

  加えて noindex ではないが「index されない URL」も落とす:
    - canonical を他 URL に向けたページ (.Params.canonicalURL が自分と違う)
  こちらは head.html に対応する条件が無い (canonical と noindex は併用しないのが
  定石なので、統合先へ寄せたページも robots は index,follow のまま出す)。それでも
  sitemap は「index してほしい URL」を伝える場所なので、自分で「正本は別だ」と
  宣言した URL を載せるのは矛盾しており、上と同じ理由でクロールバジェットを削る。
  ※ paginate 2ページ目以降 ($isPaginated) は sitemap に Page として現れないため対象外。
  本文・URL 構造・既存 noindex 意図は不変 (sitemap 出力のみを絞る)。
*/ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $threshold := int (site.Params.thinTermNoindexThreshold | default 3) -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range .Pages -}}
  {{- $p := . -}}
  {{- $skip := false -}}
  {{- if eq $p.Params.robotsNoIndex true -}}{{- $skip = true -}}{{- end -}}
  {{- if and (eq $p.Kind "term") (lt (len $p.Pages) $threshold) -}}{{- $skip = true -}}{{- end -}}
  {{- if and (eq $p.Kind "term") (eq $p.Data.Plural "brands") -}}
    {{- with site.Data.brand_hub -}}
      {{- $entry := index .brands $p.Title -}}
      {{- if and $entry $entry.noindex -}}{{- $skip = true -}}{{- end -}}
    {{- end -}}
  {{- end -}}
  {{- /* #2701 P3: ブランド名と一致する tag は /brands/ を正本に noindex 化したため除外。 */ -}}
  {{- if and (eq $p.Kind "term") (eq $p.Data.Plural "tags") (partial "is_brand_tag.html" $p.Title) -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- /* #2765: 情報型 hub と同一トピックの tag は hub を正本に noindex 化したため除外。 */ -}}
  {{- if and (eq $p.Kind "term") (eq $p.Data.Plural "tags") (partial "hub_for_tag.html" $p.Title) -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- /* #2719: 低価値な tag (low_value_tags denylist) は head.html で noindex 化したため除外。 */ -}}
  {{- if and (eq $p.Kind "term") (eq $p.Data.Plural "tags") (partial "is_low_value_tag.html" $p.Title) -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- /* #5343 follow-up: term が 1 つも無い taxonomy 一覧ページ (実測では /categories/)。
         head.html と同じ判定を使う。 */ -}}
  {{- if partial "is_empty_taxonomy.html" $p -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- /* #2370 A-3: canonical を他 URL に寄せたページ (build_post.py が
         data/analytics/canonical_overrides.json から .Params.canonicalURL を付ける)。
         実測 (2026-08-17): /products/b0gfvtpdbm/ が /products/b0gl815n6k/ へ統合済み
         なのに sitemap に載ったままで、GSC 側も「代替ページ (適切な canonical タグ
         あり)」1 件として計上していた。末尾スラッシュの有無だけの差は同一とみなす。 */ -}}
  {{- with $p.Params.canonicalURL -}}
    {{- if ne (strings.TrimSuffix "/" .) (strings.TrimSuffix "/" $p.Permalink) -}}
      {{- $skip = true -}}
    {{- end -}}
  {{- end -}}
  {{- if and (not $skip) $p.Permalink -}}
  <url>
    <loc>{{ $p.Permalink }}</loc>
    {{- if not $p.Lastmod.IsZero }}<lastmod>{{ $p.Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{- end }}
    {{- with $p.Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{- end }}
    {{- if ge $p.Sitemap.Priority 0.0 }}<priority>{{ $p.Sitemap.Priority }}</priority>{{- end }}
  </url>
  {{- end -}}
{{- end }}
</urlset>
