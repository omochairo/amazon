{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Article JSON (おもちゃいろ v4)",
  "description": "STAGE 1 Jules output schema. Target reader: 20-40s female. SEO: product-name driven.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "meta_description",
    "date",
    "tags",
    "keywords",
    "persona_fit",
    "narrative",
    "faq",
    "product"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[A-Z0-9]+$" },
    "title": { "type": "string", "minLength": 20, "maxLength": 80 },
    "meta_description": { "type": "string", "minLength": 100, "maxLength": 160 },
    "date": { "type": "string", "format": "date-time" },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "minItems": 5,
      "maxItems": 15,
      "items": { "type": "string" }
    },
    "persona_fit": {
      "type": "object",
      "required": ["recommended_for", "gift_scene", "age_range", "primary_buyer"],
      "properties": {
        "recommended_for": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "gift_scene": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "age_range": { "type": "string" },
        "primary_buyer": { "type": "string" }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["lead", "why_this_product", "gift_appeal", "daily_use", "safety_note", "closing"],
      "properties": {
        "lead": { "type": "string", "minLength": 120 },
        "why_this_product": { "$ref": "#/definitions/narrativeSection" },
        "gift_appeal":      { "$ref": "#/definitions/narrativeSection" },
        "daily_use":        { "$ref": "#/definitions/narrativeSection" },
        "safety_note":      { "$ref": "#/definitions/narrativeSection" },
        "closing":          { "$ref": "#/definitions/narrativeSection" }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 5 },
          "answer": { "type": "string", "minLength": 30 }
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "asin",
        "name",
        "name_full",
        "features",
        "pros",
        "cons",
        "prices",
        "best_platform",
        "best_price"
      ],
      "properties": {
        "asin": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "name": { "type": "string" },
        "name_full": { "type": "string" },
        "brand": { "type": "string" },
        "image": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "intro": { "type": "string" },
        "pros": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "cons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ivs_score": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
        "ivs_detail": {
          "type": "object",
          "required": ["education", "longevity", "safety", "cost_performance", "total", "total_100"],
          "properties": {
            "education": { "type": "number" },
            "longevity": { "type": "number" },
            "safety": { "type": "number" },
            "cost_performance": { "type": "number" },
            "total": { "type": "number" },
            "total_100": { "type": "integer" },
            "pattern": { "type": "string", "enum": ["A", "B"] },
            "score_rationale": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": ["factor", "delta", "reason"],
                "properties": {
                  "factor": { "type": "string" },
                  "delta": { "type": "string" },
                  "reason": { "type": "string", "minLength": 10 }
                }
              }
            }
          }
        },
        "prices": {
          "type": "object",
          "properties": {
            "amazon": { "type": "object" },
            "rakuten": { "type": "object" },
            "yahoo": { "type": "object" }
          }
        },
        "best_platform": { "type": "string" },
        "best_price": { "type": "integer" },
        "target_age": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*[0-9０-９].*(歳|才|ヶ月|か月)"
        },
        "certifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "edu_domains": {
          "type": "array",
          "items": { "type": "string", "enum": ["STEM", "言語", "運動", "想像"] },
          "uniqueItems": true
        }
      }
    },
    "youtube_embeds": { "type": "array" },
    "news": { "type": "array" },
    "books": { "type": "array" },
    "internal_links": { "type": "array" },
    "editorial_comment": { "type": "string", "minLength": 80 }
  },
  "definitions": {
    "narrativeSection": {
      "description": "δ-A: 散文 string か、短文 (60-120字) を 2-4 要素並べた array。array 推奨 (読みやすさ向上)。",
      "oneOf": [
        { "type": "string", "minLength": 120 },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 30, "maxLength": 160 }
        }
      ]
    }
  }
}
